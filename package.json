{
  "name": "financial-vellun",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm db:up && concurrently -n api,web,agent -c blue,green,magenta \"pnpm api:dev\" \"pnpm web:dev\" \"pnpm agent:dev\"",
    "api:dev": "pnpm --filter @financial-vellun/api dev",
    "web:dev": "pnpm --filter @financial-vellun/web dev",
    "agent:dev": "node apps/ai-agent/scripts/run-python.mjs -m uvicorn src.main:app --reload --port 8010",
    "agent:worker": "node apps/ai-agent/scripts/run-python.mjs -m src.worker",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "prisma:generate": "pnpm --filter @financial-vellun/api prisma:generate",
    "prisma:migrate": "pnpm --filter @financial-vellun/api prisma:migrate",
    "prisma:studio": "pnpm --filter @financial-vellun/api prisma:studio",
    "prisma:seed": "pnpm --filter @financial-vellun/api db:seed",
    "prisma:seed:loadtest": "pnpm --filter @financial-vellun/api db:seed:loadtest",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "pnpm --filter @financial-vellun/api exec tsc --noEmit -p tsconfig.build.json",
    "test": "pnpm --filter @financial-vellun/api test && pnpm test:agent",
    "test:agent": "node apps/ai-agent/scripts/run-python.mjs -m pytest -q",
    "lint:workspaces": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "obs:check": "node infra/observability/check.mjs",
    "obs:up": "docker compose -f infra/docker/docker-compose.yml -f infra/observability/docker-compose.observability.yml up -d",
    "obs:down": "docker compose -f infra/docker/docker-compose.yml -f infra/observability/docker-compose.observability.yml down"
  },
  "engines": {
    "node": ">=24.22.3 <25",
    "pnpm": ">=10.34.9 <11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@scarf/scarf",
      "unrs-resolver"
    ],
    "overrides": {
      "shell-quote": "^1.11.0",
      "body-parser@<1.20.9": "^1.20.9",
      "multer@<2.5.0": "^2.5.0",
      "qs@<6.16.1": "^6.16.1",
      "lodash@<4.18.0": "^4.18.0",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "postcss@<8.5.23": "^8.5.23",
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "picomatch@>=4 <4.0.4": "^4.0.4",
      "tmp@<0.2.6": "^0.2.6",
      "ajv@>=7 <8.18.0": "^8.18.0",
      "webpack@>=5.49.0 <5.104.1": "^5.104.1"
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "concurrently": "^9.2.5",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.34.9"
}
