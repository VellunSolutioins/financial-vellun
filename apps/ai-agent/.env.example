AI_AGENT_PORT=8010
ENVIRONMENT=development
MAIN_API_URL=http://localhost:3001
INTERNAL_API_KEY=change-me-internal-api-key
OPENAI_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
LLM_PROVIDER=rules
OPENAI_MODEL=gpt-4o-mini
CONFIDENCE_THRESHOLD=0.7
CONVERSATION_TTL_MINUTES=30

# Messenger (envio de resposta ao usuário)
WHATSAPP_PROVIDER=log          # log | cloud-api
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v18.0

# Buffer / debounce de mensagens fragmentadas
MESSAGE_BUFFER_BACKEND=memory  # memory | redis
MESSAGE_BUFFER_DEBOUNCE_SECONDS=5
MESSAGE_BUFFER_MAX_MESSAGES=10
MESSAGE_BUFFER_MAX_AGE_SECONDS=30
CONVERSATION_CONTEXT_MESSAGE_LIMIT=15
CONVERSATION_CONTEXT_MAX_CHARS=4000
MESSAGE_MAX_CHARS=2000

# Redis / fila distribuída (necessário quando MESSAGE_BUFFER_BACKEND=redis)
REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_TTL_SECONDS=30
WORKER_POLL_INTERVAL_SECONDS=1.0
MESSAGE_BUFFER_MAX_RETRIES=3
MESSAGE_BUFFER_RETRY_BASE_SECONDS=1.0
