AI_AGENT_PORT=8010
# development | production. Ausente = production (seguro por padrão): exige
# WHATSAPP_WEBHOOK_SECRET, METRICS_TOKEN, INTERNAL_API_KEY com 16+ caracteres e
# WHATSAPP_PROVIDER=cloud-api, senão o agente não sobe.
ENVIRONMENT=development
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
TZ=America/Sao_Paulo
MAIN_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000  # base do link de regularização da assinatura (produção: URL pública do web)
INTERNAL_API_KEY=change-me-internal-api-key
# Chaves por direção (substituem INTERNAL_API_KEY; enquanto ela existir, segue
# aceita). Precisam ser iguais às variáveis de mesmo nome na API.
INTERNAL_API_KEY_AGENT_TO_API=
INTERNAL_API_KEY_API_TO_AGENT=
OPENAI_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
# Sem secret, o webhook recusa tudo — salvo em ambiente local com esta opção,
# usada para simular mensagens. Fora de ENVIRONMENT=development o boot recusa.
WEBHOOK_ALLOW_UNSIGNED=true
LLM_PROVIDER=rules
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=                # vazio → usa OPENAI_MODEL (comprovantes/imagem)
OPENAI_TRANSCRIPTION_MODEL=whisper-1   # transcrição de áudio (STT)
# Timeout e tentativas da OpenAI. O padrão do SDK é 600s: dez minutos segurando
# um slot de concorrência do processamento e o lock do telefone junto.
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_RETRIES=2
# Transcrição e visão movem mais bytes e toleram mais espera que texto.
OPENAI_MEDIA_TIMEOUT_SECONDS=60.0
MEDIA_MAX_BYTES=16777216            # limite de download de mídia (16 MB)
WEBHOOK_MAX_BODY_BYTES=1048576      # corpo máximo do POST do webhook (1 MB)
CONFIDENCE_THRESHOLD=0.7
AI_DAILY_MESSAGE_LIMIT=200          # mensagens processadas por telefone/dia (custo de IA); 0 desliga
CONVERSATION_TTL_MINUTES=30

# WhatsApp Cloud API (Meta)
# Com ENVIRONMENT=production, `log` (ou cloud-api sem token/phone id) impede a
# subida do agente: responder só no log em produção é falha silenciosa.
WHATSAPP_PROVIDER=log          # log | cloud-api
WHATSAPP_PROVIDER_TOKEN=       # access token (Bearer) usado para ENVIAR mensagens
WHATSAPP_PHONE_NUMBER_ID=      # phone_number_id do número da Meta
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v18.0
WHATSAPP_VERIFY_TOKEN=         # string que você inventa; igual à "Verify token" do painel da Meta
# (WHATSAPP_WEBHOOK_SECRET acima = App Secret, valida a assinatura X-Hub-Signature-256)

# ── Pipeline de mensageria ───────────────────────────────────────────────────
# broker = webhook só publica na fila e responde 202 (padrão);
# legacy = caminho antigo (buffer em processo), mantido para rollback rápido.
MESSAGE_PIPELINE=broker
MESSAGE_BROKER=rabbitmq        # rabbitmq | inmemory (dev sem Docker; NÃO é durável)
# Usuário e senha = RABBITMQ_USER/RABBITMQ_PASSWORD de infra/docker/.env.
RABBITMQ_URL=amqp://vellun:troque-esta-senha-rabbitmq@localhost:5672/
RABBITMQ_INBOUND_QUEUE=whatsapp.inbound.v1
RABBITMQ_PROCESSING_QUEUE=whatsapp.processing.v1
RABBITMQ_OUTBOUND_QUEUE=whatsapp.outbound.v1
RABBITMQ_PREFETCH=10
INBOUND_CONSUMER_CONCURRENCY=5
PROCESSING_CONSUMER_CONCURRENCY=3
# Entregas simultâneas ao WhatsApp: réplicas do worker × este número é o total
# de chamadas em voo contra a Graph API. Precisa caber no rate limit da Meta.
OUTBOUND_CONSUMER_CONCURRENCY=3
# queue = a resposta é publicada em RABBITMQ_OUTBOUND_QUEUE e entregue por um
# consumer próprio (padrão); direct = entrega no caminho que a calculou, como
# antes. `direct` é o rollback sem deploy de código.
OUTBOUND_DELIVERY=queue
MESSAGE_MAX_RETRIES=5          # tentativas antes de mandar para a DLQ
MESSAGE_RETRY_BASE_SECONDS=1.0 # backoff = base * 2^tentativa (com jitter)
MESSAGE_RETRY_MAX_SECONDS=300.0
# false → esta instância só recebe webhooks; o consumo roda em `python -m src.worker`
RUN_CONSUMERS_IN_API=true
SHUTDOWN_DRAIN_SECONDS=20.0
# Drena as DLQs para o catálogo de falhas no Postgres (painel de operações).
# false → as mensagens ficam só na DLQ e o painel não enxerga nada.
RUN_DLQ_CATALOG_CONSUMER=true
DLQ_CATALOG_PREFETCH=5
# Ao catalogar uma falha, avisa o usuário que a mensagem não foi processada — no
# máximo uma vez por telefone nesta janela (segundos). 0 desliga o aviso.
DLQ_USER_NOTICE_COOLDOWN_SECONDS=600

# ── Estado distribuído (Redis) ───────────────────────────────────────────────
# Senha = REDIS_PASSWORD de infra/docker/.env (o Redis local exige autenticação).
REDIS_URL=redis://:troque-esta-senha-redis@localhost:6379/0
GROUP_STORE_BACKEND=redis          # redis | memory (agrupamento + locks)
CONVERSATION_STATE_BACKEND=redis   # redis | memory (confirmações pendentes)
CONVERSATION_STATE_TTL_SECONDS=1800
PROCESSING_LOCK_TTL_SECONDS=120    # lock por telefone durante o processamento
JOB_DEDUPE_TTL_SECONDS=86400       # janela de deduplicação por jobId
REDIS_LOCK_TTL_SECONDS=30          # lock durante a consolidação do grupo
WORKER_POLL_INTERVAL_SECONDS=1.0

# Agrupamento (debounce) de mensagens fragmentadas
MESSAGE_BUFFER_DEBOUNCE_SECONDS=5
MESSAGE_BUFFER_MAX_MESSAGES=10
MESSAGE_BUFFER_MAX_AGE_SECONDS=30
CONVERSATION_CONTEXT_MESSAGE_LIMIT=15
CONVERSATION_CONTEXT_MAX_CHARS=4000
MESSAGE_MAX_CHARS=2000

# Somente para MESSAGE_PIPELINE=legacy (buffer em processo, será removido)
MESSAGE_BUFFER_BACKEND=memory  # memory | redis
MESSAGE_BUFFER_MAX_RETRIES=3
MESSAGE_BUFFER_RETRY_BASE_SECONDS=1.0

# ── Observabilidade ──────────────────────────────────────────────────────────
# Bearer exigido em GET /metrics e /metrics.json. Use o MESMO valor da API: o
# Alloy coleta os dois serviços com um só token. Vazio libera o endpoint em
# desenvolvimento e o FECHA em produção (variável esquecida não vira exposição).
METRICS_TOKEN=local-dev-metrics-token

# Porta do HTTP mínimo do worker (`python -m src.worker`), que expõe /metrics e
# /health/*. Sem ela as réplicas de consumo — onde o trabalho acontece — ficam
# invisíveis para o scrape e para o orquestrador.
WORKER_METRICS_PORT=8011

# Envio de logs ao Loki, via `loki.source.api` do Alloy. Sem a variável não há
# envio — em desenvolvimento não há Alloy, e tentar conectar em nada geraria ruído.
# No Railway: http://alloy.railway.internal:3100
# Local (com o compose de observabilidade no ar): http://localhost:3100
#
# SÓ o endereço base, sem caminho: a aplicação acrescenta `/loki/api/v1/push`
# sozinha. Com o caminho, o envio vai para uma URL que não existe — e falha em
# silêncio, porque o transporte nunca interrompe a aplicação.
#
# A aplicação empurra porque o Railway NÃO tem log drain. Ver docs/observability.md.
LOKI_PUSH_URL=
