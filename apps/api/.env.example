DATABASE_URL=postgresql://vellun:vellun_dev_password@localhost:5432/financial_vellun
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
API_PORT=3001
INTERNAL_API_KEY=change-me-internal-api-key
WEB_URL=http://localhost:3000
# Base do agente de IA (envio de boas-vindas por WhatsApp no cadastro).
AI_AGENT_URL=http://localhost:8010
TZ=America/Sao_Paulo

# Rollout da obrigatoriedade de assinatura (feature flag). `false` = soft launch
# (não bloqueia ninguém); ausente/qualquer outro valor = obrigatoriedade ativa.
BILLING_ENFORCEMENT_ENABLED=true

# Asaas (gateway de pagamento) — sandbox e produção têm credenciais distintas.
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=change-me-asaas-api-key
ASAAS_WEBHOOK_TOKEN=change-me-asaas-webhook-token

# Base das URLs de retorno do checkout (success/cancel). O Asaas RECUSA
# `localhost`; em desenvolvimento aponte para uma URL pública (ex.: túnel ngrok)
# para conseguir abrir o checkout. Se vazio, cai no WEB_URL.
BILLING_CALLBACK_BASE_URL=

# ── Área de operações (/ops) ─────────────────────────────────────────────────
# Identidade dos operadores: GitHub OAuth + pertencer à organização. É uma
# identidade SEPARADA da do produto — nenhum cliente vira operador.

# Segredo da sessão de operador. Precisa ser DIFERENTE de JWT_SECRET: a API
# recusa subir a sessão de ops se os dois forem iguais.
OPS_JWT_SECRET=change-me-ops-secret-at-least-32-chars

# Organização cujo pertencimento (state `active`) é exigido no login.
OPS_GITHUB_ORG=VellunSolutioins

# OAuth App do GitHub (Settings → Developer settings → OAuth Apps).
OPS_GITHUB_CLIENT_ID=change-me-github-client-id
OPS_GITHUB_CLIENT_SECRET=change-me-github-client-secret

# Callback registrado no OAuth App. Se vazio, é derivado de API_URL (ou
# http://localhost:3001) + /ops/auth/github/callback.
OPS_GITHUB_CALLBACK_URL=
# Base pública da API, usada para derivar o callback acima.
API_URL=http://localhost:3001

# Semeadura do PRIMEIRO operador, para resolver o ovo-e-galinha: todo primeiro
# login nasce `viewer` inativo, e ativar exige um `ops_admin` que ainda não
# existe. Só tem efeito se a tabela `ops_operators` estiver VAZIA e o login bater
# exatamente. Depois do primeiro operador pode ser removida.
OPS_BOOTSTRAP_ADMIN_GITHUB_LOGIN=
