DATABASE_URL=postgresql://vellun:vellun_dev_password@localhost:5432/financial_vellun
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
API_PORT=3001
INTERNAL_API_KEY=change-me-internal-api-key
# Chaves por direção (substituem INTERNAL_API_KEY; enquanto ela existir, segue
# aceita). Iguais às variáveis de mesmo nome no agente. Migração: definir as
# duas nos dois serviços, fazer o deploy e só então remover INTERNAL_API_KEY.
INTERNAL_API_KEY_AGENT_TO_API=
INTERNAL_API_KEY_API_TO_AGENT=
WEB_URL=http://localhost:3000
# Origens extras aceitas por CORS/CSRF, separadas por vírgula e exatas. Em
# produção, localhost e previews da Vercel NÃO são aceitos automaticamente.
WEB_ALLOWED_ORIGINS=
# Redis do rate limit compartilhado entre réplicas (mesma instância do agente,
# chaves com prefixo `rl:`). Vazio: conta em memória, por réplica.
REDIS_URL=redis://:troque-esta-senha-redis@localhost:6379/0
# Proxies confiáveis na frente da API, para `req.ip` ser o do cliente. Vazio:
# 1 em produção (proxy da plataforma), nenhum fora dela.
TRUST_PROXY=
# Base do agente de IA (reprocessamento de falhas pelo painel de operações).
AI_AGENT_URL=http://localhost:8010
# Número do bot no WhatsApp (só dígitos, com DDI: 5511999999999). Monta o link
# wa.me e o QR code da verificação do número do usuário; vazio, a tela mostra só
# o código.
WHATSAPP_BOT_NUMBER=
TZ=America/Sao_Paulo
# Dias que o texto das conversas com a IA (ai_messages.content e
# ai_extracted_transactions.raw_input) fica guardado. Depois disso um job diário
# o substitui por um marcador, mantendo a linha. 0 desliga. Ver
# docs/retencao-e-backups.md
AI_CONTENT_RETENTION_DAYS=90

# E-mail transacional (recuperação de senha). `log` só imprime o conteúdo no
# console da API (útil em dev, é assim que se pega o link de redefinição);
# `resend` envia de verdade e exige RESEND_API_KEY + MAIL_FROM.
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM=Financial Vellun <nao-responda@seudominio.com.br>

# Rollout da obrigatoriedade de assinatura (feature flag). `false` = soft launch
# (não bloqueia ninguém); ausente/qualquer outro valor = obrigatoriedade ativa.
BILLING_ENFORCEMENT_ENABLED=true

# Asaas (gateway de pagamento) — sandbox e produção têm credenciais distintas.
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=change-me-asaas-api-key
ASAAS_WEBHOOK_TOKEN=change-me-asaas-webhook-token

# Base das URLs de retorno do checkout (success/cancel). O Asaas RECUSA
# `localhost`; em desenvolvimento aponte para uma URL pública (ex.: túnel ngrok)
# para conseguir abrir o checkout. Se vazio, cai no WEB_URL.
BILLING_CALLBACK_BASE_URL=

# ── Observabilidade ──────────────────────────────────────────────────────────
# Bearer exigido em GET /metrics. Use o MESMO valor no agente de IA: o Alloy
# coleta os três serviços com um só token. Sem a variável o endpoint fica
# FECHADO (401), não aberto — variável esquecida no deploy não deve virar
# exposição pública de rotas e volume de negócio.
METRICS_TOKEN=local-dev-metrics-token

# Envio de logs ao Loki, via `loki.source.api` do Alloy. Sem a variável não há
# envio — em desenvolvimento não há Alloy, e tentar conectar em nada geraria ruído.
# No Railway: http://alloy.railway.internal:3100
# Local (com o compose de observabilidade no ar): http://localhost:3100
#
# SÓ o endereço base, sem caminho: a aplicação acrescenta `/loki/api/v1/push`
# sozinha. Com o caminho, o envio vai para uma URL que não existe — e falha em
# silêncio, porque o transporte nunca interrompe a aplicação.
#
# A aplicação empurra porque o Railway NÃO tem log drain. Ver docs/observability.md.
LOKI_PUSH_URL=http://localhost:3100

# ── Área de operações (/ops) ─────────────────────────────────────────────────
# Identidade dos operadores: GitHub OAuth + pertencer à organização. É uma
# identidade SEPARADA da do produto — nenhum cliente vira operador.

# Segredo da sessão de operador. Precisa ser DIFERENTE de JWT_SECRET: a API
# recusa subir a sessão de ops se os dois forem iguais.
OPS_JWT_SECRET=change-me-ops-secret-at-least-32-chars

# Organização cujo pertencimento (state `active`) é exigido no login.
OPS_GITHUB_ORG=VellunSolutioins
# Token da organização só com leitura de membros (fine-grained: Members read).
# Revalida, a cada renovação da sessão do painel, se o operador ainda pertence à
# organização. Vazio: a sessão só cai pelo prazo absoluto (12 h) ou ao
# desativar o operador.
OPS_GITHUB_ORG_TOKEN=

# OAuth App do GitHub (Settings → Developer settings → OAuth Apps).
OPS_GITHUB_CLIENT_ID=change-me-github-client-id
OPS_GITHUB_CLIENT_SECRET=change-me-github-client-secret

# Callback registrado no OAuth App. Se vazio, é derivado de API_URL (ou
# http://localhost:3001) + /ops/auth/github/callback.
OPS_GITHUB_CALLBACK_URL=
# Base pública da API, usada para derivar o callback acima.
API_URL=http://localhost:3001

# Semeadura do PRIMEIRO operador, para resolver o ovo-e-galinha: todo primeiro
# login nasce `viewer` inativo, e ativar exige um `ops_admin` que ainda não
# existe. Só tem efeito se a tabela `ops_operators` estiver VAZIA e o login bater
# exatamente. Depois do primeiro operador pode ser removida.
OPS_BOOTSTRAP_ADMIN_GITHUB_LOGIN=

# Grafana Cloud, para os links do painel de operações. O painel NÃO consulta o
# Grafana — ele leva até lá, e por isso basta a URL pública da organização.
# Vazio desliga a seção de links, em vez de mostrar link quebrado.
OPS_GRAFANA_URL=

# UID da fonte de dados Loki na sua organização (Connections → Data sources →
# a URL termina em /datasources/edit/<uid>). Sem ele o painel ainda linka os
# dashboards, mas não consegue montar o Explore filtrado por correlationId.
OPS_GRAFANA_LOKI_DATASOURCE_UID=
