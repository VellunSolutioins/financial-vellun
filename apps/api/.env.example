DATABASE_URL=postgresql://vellun:vellun_dev_password@localhost:5432/financial_vellun
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
API_PORT=3001
INTERNAL_API_KEY=change-me-internal-api-key
WEB_URL=http://localhost:3000
# Base do agente de IA (envio de boas-vindas por WhatsApp no cadastro).
AI_AGENT_URL=http://localhost:8010
TZ=America/Sao_Paulo

# E-mail transacional (recuperação de senha). `log` só imprime o conteúdo no
# console da API (útil em dev, é assim que se pega o link de redefinição);
# `resend` envia de verdade e exige RESEND_API_KEY + MAIL_FROM — o remetente
# precisa ser de um domínio verificado no Resend (não funciona com @gmail.com).
# Passo a passo no README, seção "E-mail transacional (recuperação de senha)".
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM=Financial Vellun <nao-responda@seudominio.com.br>

# Rollout da obrigatoriedade de assinatura (feature flag). `false` = soft launch
# (não bloqueia ninguém); ausente/qualquer outro valor = obrigatoriedade ativa.
BILLING_ENFORCEMENT_ENABLED=true

# Asaas (gateway de pagamento) — sandbox e produção têm credenciais distintas.
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=change-me-asaas-api-key
ASAAS_WEBHOOK_TOKEN=change-me-asaas-webhook-token

# Base das URLs de retorno do checkout (success/cancel). O Asaas RECUSA
# `localhost`; em desenvolvimento aponte para uma URL pública (ex.: túnel ngrok)
# para conseguir abrir o checkout. Se vazio, cai no WEB_URL.
BILLING_CALLBACK_BASE_URL=
