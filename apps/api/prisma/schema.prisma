generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum ProfileType {
  individual
  business
}

enum TransactionType {
  income
  expense
  transfer
}

enum TransactionStatus {
  confirmed
  pending
  cancelled
}

enum TransactionSource {
  manual
  whatsapp
  ai
  import
  recurring
}

enum RecurrenceType {
  avulso
  fixo
  parcelado
}

// ── Recorrências (despesas/receitas fixas) ────────────────────────────────────

enum RecurringFrequency {
  monthly
  bimonthly
  semiannual
  annual
}

enum SavingsYieldPeriod {
  monthly
  annual
}

enum ReminderStatus {
  pending
  paid
}

enum AccountType {
  checking
  savings
  cash
  credit_card
  digital_wallet
  investment
  other
}

enum ContactType {
  client
  supplier
}

enum AiConversationStatus {
  active
  completed
  abandoned
}

enum AiMessageDirection {
  inbound
  outbound
}

enum AiExtractionStatus {
  pending
  confirmed
  rejected
}

// ── Billing ─────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  pending
  trialing
  active
  past_due
  canceled
  unpaid
  expired
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  refunded
  partially_refunded
  chargeback
  canceled
}

enum BillingInterval {
  monthly
  annual
}

enum PaymentMethodType {
  credit_card
}

enum WebhookEventStatus {
  received
  processing
  processed
  failed
}

// ── Core ──────────────────────────────────────────────────────────────────────

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  phone        String?
  passwordHash String      @map("password_hash")
  profileType  ProfileType @map("profile_type")

  // Endereço de cobrança (usado pelo provedor de pagamentos). Nullable para não
  // quebrar usuários anteriores à introdução do campo; obrigatório em novos
  // cadastros via DTO. `city`/`state` são derivados do CEP pelo Asaas, mas
  // mantidos aqui para exibição e registros próprios.
  postalCode    String? @map("postal_code")
  street        String?
  addressNumber String? @map("address_number")
  complement    String?
  neighborhood  String?
  city          String?
  state         String?

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  individualProfile       IndividualProfile?
  businessProfile         BusinessProfile?
  accounts                Account[]
  categories              Category[]
  contacts                Contact[]
  transactions            Transaction[]
  whatsappContacts        WhatsappContact[]
  aiConversations         AiConversation[]
  aiExtractedTransactions AiExtractedTransaction[]
  subscriptions           Subscription[]
  payments                Payment[]
  recurringRules          RecurringRule[]
  spendingGoals           SpendingGoal[]
  savingsBoxes            SavingsBox[]
  reminders               Reminder[]
  agendaEvents            AgendaEvent[]

  @@map("users")
}

model IndividualProfile {
  id        String    @id @default(uuid())
  userId    String    @unique @map("user_id")
  cpf       String    @unique
  birthDate DateTime? @map("birth_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("individual_profiles")
}

model BusinessProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  companyName String   @map("company_name")
  tradeName   String?  @map("trade_name")
  cnpj        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

// ── Financial ─────────────────────────────────────────────────────────────────

model Account {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  name           String
  type           AccountType
  initialBalance Decimal     @default(0) @map("initial_balance") @db.Decimal(15, 2)
  currentBalance Decimal     @default(0) @map("current_balance") @db.Decimal(15, 2)
  currency       String      @default("BRL")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]
  creditCard     CreditCard?

  @@index([userId])
  @@map("accounts")
}

/// Extensão 1:1 de Account (type=credit_card). "Fatura atual" é derivada do
/// próprio saldo da conta (currentBalance = initialBalance + income - expense,
/// e cartão nunca recebe income, então currentBalance é sempre <= 0) — não há
/// fechamento de fatura nem pagamento nesta versão, é só gestão/controle.
model CreditCard {
  id          String   @id @default(uuid())
  accountId   String   @unique @map("account_id")
  brand       String?
  color       String?
  creditLimit Decimal? @db.Decimal(15, 2) @map("credit_limit")
  /// Dia do mês em que a fatura vence (1–28).
  dueDay      Int      @map("due_day")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("credit_cards")
}

/// Lembrete de conta a pagar. "Vencido" é derivado (pending && dueDate < hoje
/// em America/Sao_Paulo), nunca persistido — ver reminders.service.ts.
model Reminder {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  title       String
  amount      Decimal?       @db.Decimal(15, 2)
  dueDate     DateTime       @map("due_date") @db.Date
  isRecurrent Boolean        @default(false) @map("is_recurrent")
  /// Só relevante quando isRecurrent=true. Sem ela, repete indefinidamente.
  recurrenceEndDate DateTime? @map("recurrence_end_date") @db.Date
  status      ReminderStatus @default(pending)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reminders")
}

model AgendaEvent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  description String?
  eventDate   DateTime @map("event_date") @db.Date
  /// Formato "HH:mm". Ausente = compromisso do dia todo.
  eventTime   String?  @map("event_time")
  color       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("agenda_events")
}

model Category {
  id          String          @id @default(uuid())
  userId      String?         @map("user_id")
  name        String
  type        TransactionType
  color       String?
  icon        String?
  costCenter  String?         @map("cost_center")
  profileType ProfileType     @map("profile_type")
  isDefault   Boolean         @default(false) @map("is_default")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]
  spendingGoals  SpendingGoal[]

  @@index([userId])
  @@map("categories")
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  accountId       String            @map("account_id")
  categoryId      String?           @map("category_id")
  type            TransactionType
  amount          Decimal           @db.Decimal(15, 2)
  description     String
  transactionDate DateTime          @map("transaction_date") @db.Date
  status          TransactionStatus @default(confirmed)
  source          TransactionSource @default(manual)
  rawInput        String?           @map("raw_input")
  recurrenceType    RecurrenceType @default(avulso) @map("recurrence_type")
  seriesId          String?        @map("series_id")
  installmentNumber Int?           @map("installment_number")
  installmentTotal  Int?           @map("installment_total")
  recurringRuleId   String?        @map("recurring_rule_id")
  competenceMonth   String?        @map("competence_month")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  aiExtractedTransactions AiExtractedTransaction[]

  @@unique([recurringRuleId, competenceMonth])
  @@index([userId])
  @@index([transactionDate])
  @@index([type])
  @@index([categoryId])
  @@index([accountId])
  @@index([seriesId])
  @@map("transactions")
}

model Contact {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  name      String
  type      ContactType
  document  String?
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("contacts")
}

/// Regra de receita/despesa fixa ("Despesas Fixas e Recorrências"). Um cron
/// diário gera Transaction (source=recurring, status=pending) nos meses em
/// que a regra vence, respeitando `frequency`. `amount` é o valor nominal da
/// regra — usado no card "Comprometido com fixos" independente de já ter sido
/// gerado o lançamento do mês corrente.
model RecurringRule {
  id          String             @id @default(uuid())
  userId      String             @map("user_id")
  accountId   String             @map("account_id")
  categoryId  String?            @map("category_id")
  type        TransactionType
  description String
  amount      Decimal            @db.Decimal(15, 2)
  frequency   RecurringFrequency @default(monthly)
  /// Dia do mês em que vence (1–28, evita ambiguidade em meses curtos).
  dueDay      Int                @map("due_day")
  startDate   DateTime           @map("start_date") @db.Date
  endDate     DateTime?          @map("end_date") @db.Date
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
  @@index([isActive])
  @@map("recurring_rules")
}

model SpendingGoal {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  categoryId String   @map("category_id")
  amount     Decimal  @db.Decimal(15, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
  @@map("spending_goals")
}

/// Caixinha (earmarking virtual): meta e prazo são opcionais (pode ser só
/// acumular sem alvo definido). Rendimento opcional é aplicado
/// automaticamente pelo cron (ver savings-boxes.service.ts) como um aporte
/// sintético — por isso `SavingsContribution.yieldCompetence` existe: chave
/// "YYYY-MM" (mensal) ou "YYYY" (anual) com `@@unique` para não aplicar duas
/// vezes no mesmo período (mesmo padrão de `RecurringRule`/`competenceMonth`).
model SavingsBox {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  name         String
  color        String?
  targetAmount Decimal?            @db.Decimal(15, 2) @map("target_amount")
  targetDate   DateTime?           @map("target_date") @db.Date
  yieldRate    Decimal?            @db.Decimal(6, 3) @map("yield_rate")
  yieldPeriod  SavingsYieldPeriod? @map("yield_period")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@index([userId])
  @@map("savings_boxes")
}

model SavingsContribution {
  id              String   @id @default(uuid())
  savingsBoxId    String   @map("savings_box_id")
  amount          Decimal  @db.Decimal(15, 2)
  contributedAt   DateTime @map("contributed_at") @db.Date
  note            String?
  /// Preenchido só em aportes gerados automaticamente pelo rendimento (null em aportes manuais).
  yieldCompetence String?  @map("yield_competence")
  createdAt       DateTime @default(now()) @map("created_at")

  savingsBox SavingsBox @relation(fields: [savingsBoxId], references: [id], onDelete: Cascade)

  @@unique([savingsBoxId, yieldCompetence])
  @@index([savingsBoxId])
  @@map("savings_contributions")
}

// ── WhatsApp ──────────────────────────────────────────────────────────────────

model WhatsappContact {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  phoneNumber String   @unique @map("phone_number")
  provider    String?
  isVerified  Boolean  @default(false) @map("is_verified")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  aiConversations AiConversation[]

  @@map("whatsapp_contacts")
}

// ── AI ────────────────────────────────────────────────────────────────────────

model AiConversation {
  id                String               @id @default(uuid())
  userId            String?              @map("user_id")
  whatsappContactId String               @map("whatsapp_contact_id")
  status            AiConversationStatus @default(active)
  lastMessageAt     DateTime?            @map("last_message_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  whatsappContact WhatsappContact @relation(fields: [whatsappContactId], references: [id], onDelete: Cascade)
  messages        AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id                String             @id @default(uuid())
  conversationId    String             @map("conversation_id")
  direction         AiMessageDirection
  content           String
  metadata          Json?
  providerMessageId String?            @unique @map("provider_message_id")
  providerTimestamp DateTime?          @map("provider_timestamp")
  processedAt       DateTime?          @map("processed_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  conversation            AiConversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiExtractedTransactions AiExtractedTransaction[]

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiExtractedTransaction {
  id               String             @id @default(uuid())
  userId           String             @map("user_id")
  transactionId    String?            @map("transaction_id")
  sourceMessageId  String?            @map("source_message_id")
  rawInput         String             @map("raw_input")
  extractedPayload Json               @map("extracted_payload")
  confidence       Float
  status           AiExtractionStatus @default(pending)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  sourceMessage AiMessage?   @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@map("ai_extracted_transactions")
}

// ── Billing ─────────────────────────────────────────────────────────────────

model Plan {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String?
  price       Decimal         @db.Decimal(15, 2)
  currency    String          @default("BRL")
  interval    BillingInterval
  isActive    Boolean         @default(true) @map("is_active")
  features    Json?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String             @map("user_id")
  planId                 String             @map("plan_id")
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  status                 SubscriptionStatus @default(pending)
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  graceUntil             DateTime?          @map("grace_until")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan                @relation(fields: [planId], references: [id])
  payments Payment[]
  audits   SubscriptionAudit[]

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                String            @id @default(uuid())
  userId            String            @map("user_id")
  subscriptionId    String?           @map("subscription_id")
  providerPaymentId String?           @unique @map("provider_payment_id")
  amount            Decimal           @db.Decimal(15, 2)
  currency          String            @default("BRL")
  status            PaymentStatus     @default(pending)
  paymentMethodType PaymentMethodType @default(credit_card) @map("payment_method_type")
  dueAt             DateTime?         @map("due_at")
  paidAt            DateTime?         @map("paid_at")
  failedAt          DateTime?         @map("failed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

model PaymentWebhookEvent {
  id               String             @id @default(uuid())
  providerEventId  String             @unique @map("provider_event_id")
  eventType        String             @map("event_type")
  status           WebhookEventStatus @default(received)
  attempts         Int                @default(0)
  receivedAt       DateTime           @default(now()) @map("received_at")
  processedAt      DateTime?          @map("processed_at")
  sanitizedPayload Json?              @map("sanitized_payload")
  lastError        String?            @map("last_error")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@map("payment_webhook_events")
}

model SubscriptionAudit {
  id             String              @id @default(uuid())
  subscriptionId String              @map("subscription_id")
  previousStatus SubscriptionStatus? @map("previous_status")
  newStatus      SubscriptionStatus? @map("new_status")
  action         String
  actor          String?
  reason         String?
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_audits")
}
