generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum ProfileType {
  individual
  business
}

enum TransactionType {
  income
  expense
  transfer
}

enum TransactionStatus {
  confirmed
  pending
  cancelled
}

enum TransactionSource {
  manual
  whatsapp
  ai
  import
  recurring
}

enum AccountType {
  checking
  savings
  cash
  credit_card
  digital_wallet
  investment
  other
}

enum ContactType {
  client
  supplier
}

enum AiConversationStatus {
  active
  completed
  abandoned
}

enum AiMessageDirection {
  inbound
  outbound
}

enum AiExtractionStatus {
  pending
  confirmed
  rejected
}

// ── Billing ─────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  pending
  trialing
  active
  past_due
  canceled
  unpaid
  expired
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  refunded
  partially_refunded
  chargeback
  canceled
}

enum BillingInterval {
  monthly
  annual
}

enum PaymentMethodType {
  credit_card
}

enum WebhookEventStatus {
  received
  processing
  processed
  failed
}

// ── Core ──────────────────────────────────────────────────────────────────────

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  phone        String?
  passwordHash String      @map("password_hash")
  profileType  ProfileType @map("profile_type")

  // Endereço de cobrança (usado pelo provedor de pagamentos). Nullable para não
  // quebrar usuários anteriores à introdução do campo; obrigatório em novos
  // cadastros via DTO. `city`/`state` são derivados do CEP pelo Asaas, mas
  // mantidos aqui para exibição e registros próprios.
  postalCode    String? @map("postal_code")
  street        String?
  addressNumber String? @map("address_number")
  complement    String?
  neighborhood  String?
  city          String?
  state         String?

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  individualProfile       IndividualProfile?
  businessProfile         BusinessProfile?
  accounts                Account[]
  categories              Category[]
  contacts                Contact[]
  transactions            Transaction[]
  whatsappContacts        WhatsappContact[]
  aiConversations         AiConversation[]
  aiExtractedTransactions AiExtractedTransaction[]
  subscriptions           Subscription[]
  payments                Payment[]

  @@map("users")
}

model IndividualProfile {
  id        String    @id @default(uuid())
  userId    String    @unique @map("user_id")
  cpf       String    @unique
  birthDate DateTime? @map("birth_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("individual_profiles")
}

model BusinessProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  companyName String   @map("company_name")
  tradeName   String?  @map("trade_name")
  cnpj        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

// ── Financial ─────────────────────────────────────────────────────────────────

model Account {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  name           String
  type           AccountType
  initialBalance Decimal     @default(0) @map("initial_balance") @db.Decimal(15, 2)
  currentBalance Decimal     @default(0) @map("current_balance") @db.Decimal(15, 2)
  currency       String      @default("BRL")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id          String          @id @default(uuid())
  userId      String?         @map("user_id")
  name        String
  type        TransactionType
  color       String?
  icon        String?
  costCenter  String?         @map("cost_center")
  profileType ProfileType     @map("profile_type")
  isDefault   Boolean         @default(false) @map("is_default")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("categories")
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  accountId       String            @map("account_id")
  categoryId      String?           @map("category_id")
  type            TransactionType
  amount          Decimal           @db.Decimal(15, 2)
  description     String
  transactionDate DateTime          @map("transaction_date") @db.Date
  status          TransactionStatus @default(confirmed)
  source          TransactionSource @default(manual)
  rawInput        String?           @map("raw_input")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  aiExtractedTransactions AiExtractedTransaction[]

  @@index([userId])
  @@index([transactionDate])
  @@index([type])
  @@index([categoryId])
  @@index([accountId])
  @@map("transactions")
}

model Contact {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  name      String
  type      ContactType
  document  String?
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("contacts")
}

// ── WhatsApp ──────────────────────────────────────────────────────────────────

model WhatsappContact {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  phoneNumber String   @unique @map("phone_number")
  provider    String?
  isVerified  Boolean  @default(false) @map("is_verified")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  aiConversations AiConversation[]

  @@map("whatsapp_contacts")
}

// ── AI ────────────────────────────────────────────────────────────────────────

model AiConversation {
  id                String               @id @default(uuid())
  userId            String?              @map("user_id")
  whatsappContactId String               @map("whatsapp_contact_id")
  status            AiConversationStatus @default(active)
  lastMessageAt     DateTime?            @map("last_message_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  whatsappContact WhatsappContact @relation(fields: [whatsappContactId], references: [id], onDelete: Cascade)
  messages        AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id                String             @id @default(uuid())
  conversationId    String             @map("conversation_id")
  direction         AiMessageDirection
  content           String
  metadata          Json?
  providerMessageId String?            @unique @map("provider_message_id")
  providerTimestamp DateTime?          @map("provider_timestamp")
  processedAt       DateTime?          @map("processed_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  conversation            AiConversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiExtractedTransactions AiExtractedTransaction[]

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiExtractedTransaction {
  id               String             @id @default(uuid())
  userId           String             @map("user_id")
  transactionId    String?            @map("transaction_id")
  sourceMessageId  String?            @map("source_message_id")
  rawInput         String             @map("raw_input")
  extractedPayload Json               @map("extracted_payload")
  confidence       Float
  status           AiExtractionStatus @default(pending)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  sourceMessage AiMessage?   @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@map("ai_extracted_transactions")
}

// ── Billing ─────────────────────────────────────────────────────────────────

model Plan {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String?
  price       Decimal         @db.Decimal(15, 2)
  currency    String          @default("BRL")
  interval    BillingInterval
  isActive    Boolean         @default(true) @map("is_active")
  features    Json?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String             @map("user_id")
  planId                 String             @map("plan_id")
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  status                 SubscriptionStatus @default(pending)
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  graceUntil             DateTime?          @map("grace_until")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan                @relation(fields: [planId], references: [id])
  payments Payment[]
  audits   SubscriptionAudit[]

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                String            @id @default(uuid())
  userId            String            @map("user_id")
  subscriptionId    String?           @map("subscription_id")
  providerPaymentId String?           @unique @map("provider_payment_id")
  amount            Decimal           @db.Decimal(15, 2)
  currency          String            @default("BRL")
  status            PaymentStatus     @default(pending)
  paymentMethodType PaymentMethodType @default(credit_card) @map("payment_method_type")
  dueAt             DateTime?         @map("due_at")
  paidAt            DateTime?         @map("paid_at")
  failedAt          DateTime?         @map("failed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

model PaymentWebhookEvent {
  id               String             @id @default(uuid())
  providerEventId  String             @unique @map("provider_event_id")
  eventType        String             @map("event_type")
  status           WebhookEventStatus @default(received)
  attempts         Int                @default(0)
  receivedAt       DateTime           @default(now()) @map("received_at")
  processedAt      DateTime?          @map("processed_at")
  sanitizedPayload Json?              @map("sanitized_payload")
  lastError        String?            @map("last_error")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@map("payment_webhook_events")
}

model SubscriptionAudit {
  id             String              @id @default(uuid())
  subscriptionId String              @map("subscription_id")
  previousStatus SubscriptionStatus? @map("previous_status")
  newStatus      SubscriptionStatus? @map("new_status")
  action         String
  actor          String?
  reason         String?
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_audits")
}
