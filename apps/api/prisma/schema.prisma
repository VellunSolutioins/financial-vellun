generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Caminho da aplicação: pode passar por pooler (PgBouncer em transaction
  // mode), e por isso carrega `pgbouncer=true`, `connection_limit` e
  // `pool_timeout` — ver docs/connection-budget.md.
  url       = env("DATABASE_URL")
  // Caminho das migrations e do `prisma db push`: conexão direta, sem pooler.
  // `migrate deploy` usa advisory lock e prepared statements nomeados, que um
  // pooler em transaction mode não preserva entre comandos — a migration
  // falharia de formas difíceis de diagnosticar (contrato C7).
  //
  // Declarada, a variável passa a ser **obrigatória**: o Prisma recusa o schema
  // sem ela, inclusive em desenvolvimento. É de propósito — em dev ela aponta
  // para o mesmo Postgres de `DATABASE_URL`, e o que não queremos é alguém
  // descobrir em produção que a migration foi pelo pooler.
  directUrl = env("DIRECT_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum ProfileType {
  individual
  business
}

/// `transfer` não é mais aceito pela API nem oferecido nas telas; o valor fica
/// no enum só para não invalidar registros antigos.
enum TransactionType {
  income
  expense
  transfer
}

/// Não existe "pendente": o que ainda vai acontecer é definido pela data do
/// lançamento (futuro = data depois de hoje), não por um status.
enum TransactionStatus {
  confirmed
  cancelled
}

enum TransactionSource {
  manual
  whatsapp
  ai
  import
  recurring
}

enum AccountType {
  checking
  savings
  cash
  credit_card
  digital_wallet
  investment
  other
}

enum ContactType {
  client
  supplier
}

enum AiConversationStatus {
  active
  completed
  abandoned
}

enum AiMessageDirection {
  inbound
  outbound
}

enum AiExtractionStatus {
  pending
  confirmed
  rejected
}

// ── Billing ─────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  pending
  trialing
  active
  past_due
  canceled
  unpaid
  expired
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  refunded
  partially_refunded
  chargeback
  canceled
}

enum BillingInterval {
  monthly
  annual
}

enum PaymentMethodType {
  credit_card
}

/// Ciclo de vida de um evento de webhook do PSP.
///
/// `failed` e `exhausted` sao estados **diferentes** de proposito: antes, toda
/// falha gravava `failed`, e o painel nao conseguia distinguir "vai ser
/// retentado sozinho" de "acabou" — o operador reprocessaria por cima de um
/// retry em andamento. So `exhausted` e recuperavel pelo painel.
enum WebhookEventStatus {
  received
  processing
  processed
  failed
  exhausted
}

// ── Operações ───────────────────────────────────────────────────────────────

/// Papel do operador na área de operações. `viewer` só lê, `operator` age sobre
/// falhas, `ops_admin` administra operadores e permissões.
enum OpsRole {
  viewer
  operator
  ops_admin
}

/// Desfecho registrado na trilha de auditoria. `denied` existe para que uma
/// tentativa recusada por autorização também deixe rastro.
enum OpsAuditResult {
  success
  failure
  denied
}

/// De qual DLQ a mensagem veio.
enum OpsFailureSource {
  whatsapp_inbound
  whatsapp_processing
  whatsapp_outbound
}

/// Ciclo de vida de uma falha no catálogo.
///
/// `reprocessing` é um estado real, não um detalhe: publicar e marcar não são
/// atômicos, então uma falha entre os dois deixa a linha aqui, e um cron a
/// reconcilia. Sem esse estado, o operador não distinguiria "estou tratando"
/// de "ninguém tocou" e dois operadores reprocessariam o mesmo item.
enum OpsFailureStatus {
  pending
  reprocessing
  reprocessed
  discarded
}

// ── Core ──────────────────────────────────────────────────────────────────────

model User {
  spendingGoals SpendingGoal[]
  reminders     Reminder[]
  agendaEvents  AgendaEvent[]
  notes         Note[]
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?
  passwordHash  String         @map("password_hash")
  profileType   ProfileType    @map("profile_type")

  // Endereço de cobrança (usado pelo provedor de pagamentos). Nullable para não
  // quebrar usuários anteriores à introdução do campo; obrigatório em novos
  // cadastros via DTO. `city`/`state` são derivados do CEP pelo Asaas, mas
  // mantidos aqui para exibição e registros próprios.
  postalCode    String? @map("postal_code")
  street        String?
  addressNumber String? @map("address_number")
  complement    String?
  neighborhood  String?
  city          String?
  state         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  individualProfile       IndividualProfile?
  businessProfile         BusinessProfile?
  accounts                Account[]
  categories              Category[]
  contacts                Contact[]
  transactions            Transaction[]
  whatsappContacts        WhatsappContact[]
  aiConversations         AiConversation[]
  aiExtractedTransactions AiExtractedTransaction[]
  subscriptions           Subscription[]
  payments                Payment[]
  sessions                UserSession[]
  securityEvents          UserSecurityEvent[]
  phoneVerifications      PhoneVerification[]

  @@map("users")
}

// Sessão de login revogável. Cada login cria uma linha; o refresh token gira
// nela mesma (uso único). `previousTokenHash` + `rotatedAt` toleram duas abas
// renovando ao mesmo tempo; fora dessa janela, apresentar um token antigo é
// reutilização e revoga a sessão. Os tokens nunca são guardados, só o hash.
model UserSession {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  refreshTokenHash  String    @map("refresh_token_hash")
  previousTokenHash String?   @map("previous_token_hash")
  rotatedAt         DateTime? @map("rotated_at")
  userAgent         String?   @map("user_agent")
  ip                String?
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  // Expiração deslizante (renovada a cada refresh) e prazo absoluto do login.
  expiresAt         DateTime  @map("expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  revokedAt         DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

/// Trilha das mudanças de identidade da conta: senha, e-mail, telefone e
/// encerramento de sessões. Append-only no banco (trigger, como
/// `ops_audit_log`): serve para o usuário e o suporte reconstruírem o que
/// aconteceu, e uma sessão roubada não pode apagar o próprio rastro.
///
/// Nunca guarda credencial em claro; e-mails ficam mascarados.
model UserSecurityEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  /// `password_changed`, `email_changed`, `phone_verified`, `sessions_revoked`.
  type      String
  ip        String?
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_security_events")
}

// Desafio de posse do número de WhatsApp (reverse OTP): o usuário envia o
// código ao bot a partir do número informado. Só o hash do código é guardado.
// O vínculo em `whatsapp_contacts` só é criado quando o desafio é concluído.
model PhoneVerification {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  // E.164 do número informado pelo usuário (chave da busca feita pelo agente).
  phoneNumber  String    @map("phone_number")
  // Número como o usuário digitou, gravado em `users.phone` ao verificar.
  displayPhone String    @map("display_phone")
  codeHash     String    @map("code_hash")
  attempts     Int       @default(0)
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([phoneNumber])
  @@map("phone_verifications")
}

model IndividualProfile {
  id        String    @id @default(uuid())
  userId    String    @unique @map("user_id")
  cpf       String    @unique
  birthDate DateTime? @map("birth_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("individual_profiles")
}

model BusinessProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  companyName String   @map("company_name")
  tradeName   String?  @map("trade_name")
  cnpj        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

// ── Financial ─────────────────────────────────────────────────────────────────

model Account {
  creditCard     CreditCard?
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  name           String
  type           AccountType
  initialBalance Decimal     @default(0) @map("initial_balance") @db.Decimal(15, 2)
  currentBalance Decimal     @default(0) @map("current_balance") @db.Decimal(15, 2)
  currency       String      @default("BRL")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  spendingGoals SpendingGoal[]
  id            String          @id @default(uuid())
  userId        String?         @map("user_id")
  name          String
  type          TransactionType
  color         String?
  icon          String?
  costCenter    String?         @map("cost_center")
  profileType   ProfileType     @map("profile_type")
  isDefault     Boolean         @default(false) @map("is_default")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("categories")
}

model Transaction {
  recurrenceType    RecurrenceType    @default(avulso) @map("recurrence_type")
  seriesId          String?           @map("series_id")
  installmentNumber Int?              @map("installment_number")
  installmentTotal  Int?              @map("installment_total")
  id                String            @id @default(uuid())
  userId            String            @map("user_id")
  accountId         String            @map("account_id")
  categoryId        String?           @map("category_id")
  type              TransactionType
  amount            Decimal           @db.Decimal(15, 2)
  description       String
  transactionDate   DateTime          @map("transaction_date") @db.Date
  status            TransactionStatus @default(confirmed)
  source            TransactionSource @default(manual)
  rawInput          String?           @map("raw_input")
  // Chave de idempotencia da origem (ex.: jobId do pipeline do WhatsApp).
  // Um retry apos timeout devolve o lancamento existente em vez de duplicar.
  idempotencyKey    String?           @unique @map("idempotency_key")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  aiExtractedTransactions AiExtractedTransaction[]

  @@index([seriesId])
  @@index([userId, recurrenceType, transactionDate])
  // Todo acesso a lançamento é escopado por usuário — não existe consulta que
  // varra a tabela inteira. Por isso os índices úteis começam em `userId`, e os
  // de coluna única que existiam antes (`userId`, `transactionDate`, `type`)
  // eram, na prática, o mesmo índice pior: o planner escolhia um deles e
  // filtrava o resto lendo heap.
  //
  // Listagem (ordenada por data) e série diária do dashboard.
  @@index([userId, transactionDate])
  // Agregações do dashboard (soma por tipo no período) e as listas de contas a
  // pagar/receber (confirmados com data a partir de hoje). `status` antes de
  // `type` porque toda consulta deste grupo fixa os dois.
  @@index([userId, status, type, transactionDate])
  // "Lançamentos recentes" do dashboard: ordena por `createdAt`, não por
  // `transactionDate` — um lançamento de ontem registrado agora aparece no topo.
  @@index([userId, createdAt])
  // Mantidos: são os lados "um" das relações, usados por join e pela checagem
  // de integridade ao excluir conta/categoria. Nenhum começa por `userId`, então
  // nenhum composto acima os cobre.
  @@index([categoryId])
  @@index([accountId])
  @@map("transactions")
}

model Contact {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  name      String
  type      ContactType
  document  String?
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("contacts")
}

// ── WhatsApp ──────────────────────────────────────────────────────────────────

model WhatsappContact {
  id          String    @id @default(uuid())
  userId      String?   @map("user_id")
  phoneNumber String    @unique @map("phone_number")
  provider    String?
  // Só um contato verificado e não revogado identifica o usuário no WhatsApp.
  isVerified  Boolean   @default(false) @map("is_verified")
  verifiedAt  DateTime? @map("verified_at")
  // Número desvinculado (troca de telefone ou posse comprovada por outra
  // conta). `userId` é mantido para auditoria.
  revokedAt   DateTime? @map("revoked_at")
  // Incrementa a cada mudança de dono ou revogação. O agente guarda este valor
  // junto da confirmação pendente e a descarta se ele mudar.
  linkVersion Int       @default(0) @map("link_version")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  aiConversations AiConversation[]

  @@index([userId])
  @@map("whatsapp_contacts")
}

// ── AI ────────────────────────────────────────────────────────────────────────

model AiConversation {
  id                String               @id @default(uuid())
  userId            String?              @map("user_id")
  whatsappContactId String               @map("whatsapp_contact_id")
  status            AiConversationStatus @default(active)
  lastMessageAt     DateTime?            @map("last_message_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  whatsappContact WhatsappContact @relation(fields: [whatsappContactId], references: [id], onDelete: Cascade)
  messages        AiMessage[]

  // A conversa ativa de um contato é lida em toda mensagem recebida — inclusive
  // dentro do `SELECT ... FOR UPDATE` que serializa a criação. Sem índice
  // nenhum, isso era um seq scan por mensagem, e a tabela só cresce.
  @@index([whatsappContactId, status, createdAt])
  @@map("ai_conversations")
}

model AiMessage {
  id                String             @id @default(uuid())
  conversationId    String             @map("conversation_id")
  direction         AiMessageDirection
  content           String
  metadata          Json?
  providerMessageId String?            @unique @map("provider_message_id")
  providerTimestamp DateTime?          @map("provider_timestamp")
  processedAt       DateTime?          @map("processed_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  conversation            AiConversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiExtractedTransactions AiExtractedTransaction[]

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiExtractedTransaction {
  id               String             @id @default(uuid())
  userId           String             @map("user_id")
  transactionId    String?            @map("transaction_id")
  sourceMessageId  String?            @map("source_message_id")
  rawInput         String             @map("raw_input")
  extractedPayload Json               @map("extracted_payload")
  confidence       Float
  status           AiExtractionStatus @default(pending)
  // Chave de idempotencia da origem (o `jobId` do pipeline do WhatsApp). Um
  // retry reaproveita a extracao existente em vez de criar outra orfa.
  idempotencyKey   String?            @unique @map("idempotency_key")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  sourceMessage AiMessage?   @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([userId])
  @@map("ai_extracted_transactions")
}

// ── Billing ─────────────────────────────────────────────────────────────────

model Plan {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String?
  price       Decimal         @db.Decimal(15, 2)
  currency    String          @default("BRL")
  interval    BillingInterval
  isActive    Boolean         @default(true) @map("is_active")
  features    Json?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String             @map("user_id")
  planId                 String             @map("plan_id")
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  status                 SubscriptionStatus @default(pending)
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  graceUntil             DateTime?          @map("grace_until")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan                  @relation(fields: [planId], references: [id])
  payments      Payment[]
  audits        SubscriptionAudit[]
  webhookEvents PaymentWebhookEvent[]

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                String            @id @default(uuid())
  userId            String            @map("user_id")
  subscriptionId    String?           @map("subscription_id")
  providerPaymentId String?           @unique @map("provider_payment_id")
  amount            Decimal           @db.Decimal(15, 2)
  currency          String            @default("BRL")
  status            PaymentStatus     @default(pending)
  paymentMethodType PaymentMethodType @default(credit_card) @map("payment_method_type")
  dueAt             DateTime?         @map("due_at")
  paidAt            DateTime?         @map("paid_at")
  failedAt          DateTime?         @map("failed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

model PaymentWebhookEvent {
  id               String             @id @default(uuid())
  providerEventId  String             @unique @map("provider_event_id")
  eventType        String             @map("event_type")
  status           WebhookEventStatus @default(received)
  attempts         Int                @default(0)
  receivedAt       DateTime           @default(now()) @map("received_at")
  processedAt      DateTime?          @map("processed_at")
  sanitizedPayload Json?              @map("sanitized_payload")
  lastError        String?            @map("last_error")

  /// Quando a ultima tentativa comecou. Com `nextRetryAt`, responde "esta
  /// parado ha quanto tempo?" sem depender de `updatedAt`, que muda por
  /// qualquer escrita.
  attemptedAt DateTime? @map("attempted_at")

  /// Quando o cron deve tentar de novo. **E aqui que mora a durabilidade**: o
  /// retry vivia em `setTimeout` no processo, e um deploy dentro da janela de
  /// ~7,5s perdia o evento. Agendado no banco, ele sobrevive a reinicio.
  nextRetryAt DateTime? @map("next_retry_at")

  /// Assinatura correlacionada, preenchida quando o processamento a encontra.
  /// Antes desta coluna a tabela era uma ilha: nao havia como perguntar "o que
  /// aconteceu com esta assinatura" partindo dos eventos. Nula porque nem todo
  /// evento correlaciona — e quando nao correlaciona, isso e a informacao.
  subscriptionId String?       @map("subscription_id")
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  /// A varredura do cron: eventos vencidos, por status.
  @@index([status, nextRetryAt])
  /// A listagem do painel ordena por data — sem isto, varredura completa.
  @@index([receivedAt])
  @@index([subscriptionId])
  @@map("payment_webhook_events")
}

model SubscriptionAudit {
  id             String              @id @default(uuid())
  subscriptionId String              @map("subscription_id")
  previousStatus SubscriptionStatus? @map("previous_status")
  newStatus      SubscriptionStatus? @map("new_status")
  action         String
  actor          String?
  reason         String?
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_audits")
}

// ── Operações ───────────────────────────────────────────────────────────────

/// Operador da área de operações, identificado pelo GitHub.
///
/// **Tabela separada de `users` por construção**: nenhum cliente do produto vira
/// operador por ser admin da própria conta, porque não existe caminho de código
/// entre as duas identidades. A sessão também é separada (cookie e segredo
/// próprios), então um `access_token` de cliente nunca serve aqui.
///
/// O primeiro login entra como `viewer` **inativo** — um `ops_admin` precisa
/// ativar. Pertencer à organização é condição necessária, não suficiente.
model OpsOperator {
  id           String  @id @default(uuid())
  githubLogin  String  @unique @map("github_login")
  githubUserId String  @unique @map("github_user_id")
  name         String?
  email        String?
  role         OpsRole @default(viewer)

  /// Permissão extra para ver dados sensíveis em claro (telefone, conteúdo de
  /// mensagem). Separada do papel de propósito: `operator` reprocessa sem
  /// precisar ler o conteúdo. Cada visualização gera linha de auditoria.
  canViewSensitive Boolean @default(false) @map("can_view_sensitive")

  active      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  auditEntries OpsAuditLog[]

  @@map("ops_operators")
}

/// Trilha append-only das ações de operadores.
///
/// Sem `update` nem `delete` no service, e o usuário de banco da aplicação não
/// recebe `DELETE` nesta tabela (ver a migration). A relação com `OpsOperator`
/// é `Restrict` por omissão: apagar um operador com histórico é recusado pelo
/// banco, em vez de levar a trilha embora.
model OpsAuditLog {
  id          String         @id @default(uuid())
  operatorId  String         @map("operator_id")
  action      String
  targetType  String         @map("target_type")
  targetId    String?        @map("target_id")
  reason      String?
  result      OpsAuditResult
  /// Correlaciona as linhas de uma mesma operação (um lote, por exemplo).
  operationId String         @map("operation_id")
  beforeState Json?          @map("before_state")
  afterState  Json?          @map("after_state")
  createdAt   DateTime       @default(now()) @map("created_at")

  operator OpsOperator @relation(fields: [operatorId], references: [id])

  @@index([createdAt])
  @@index([operatorId, createdAt])
  @@index([operationId])
  @@index([targetType, targetId])
  @@map("ops_audit_log")
}

/// Catálogo de falhas definitivas do pipeline WhatsApp.
///
/// **A DLQ é transporte; esta tabela é a fonte de verdade do que falhou.** O
/// RabbitMQ não oferece navegação arbitrária, paginação nem filtro: montar a tela
/// lendo a DLQ transformaria cada abertura de página em consumo e republicação da
/// fila. Um consumer dedicado drena as duas DLQs, grava aqui e só então acka.
///
/// Se esse consumer cair, as mensagens **se acumulam na DLQ** — nada se perde — e
/// a profundidade da fila dispara o alerta.
model OpsFailedMessage {
  id String @id @default(uuid())

  /// Identidade da falha, derivada do conteúdo do envelope (ver
  /// `OpsFailedMessagesService.buildDedupeKey`). Existe porque o consumer pode
  /// reentregar a mesma mensagem — um `nack` após uma gravação que expirou por
  /// timeout, por exemplo — e sem ela a mesma falha viraria duas linhas no painel.
  /// Uma falha **nova** da mesma mensagem gera chave diferente, porque `failedAt`
  /// entra na composição.
  dedupeKey String @unique @map("dedupe_key")

  source      OpsFailureSource
  sourceQueue String           @map("source_queue")
  routingKey  String           @map("routing_key")

  correlationId     String? @map("correlation_id")
  providerMessageId String? @map("provider_message_id")
  jobId             String? @map("job_id")

  /// Telefone **apenas como hash**, para agrupar falhas do mesmo número sem
  /// expô-lo. O número em claro continua dentro de `payload`, que precisa ficar
  /// íntegro para o reprocessamento funcionar — a proteção está na leitura, que
  /// mascara por padrão e só devolve em claro a operador com `canViewSensitive`,
  /// gerando linha de auditoria.
  phoneHash String? @map("phone_hash")

  errorType    String  @map("error_type")
  errorMessage String  @map("error_message")
  attempts     Int
  permanent    Boolean @default(false)

  /// Envelope original, íntegro. Sem ele não há o que republicar.
  payload Json

  status OpsFailureStatus @default(pending)

  /// Quando a mensagem tropeçou pela primeira vez (nulo se falhou permanente já
  /// na primeira tentativa). `capturedAt` é quando o catálogo a registrou — a
  /// distância entre os dois expõe atraso do consumer do catálogo.
  firstFailedAt DateTime? @map("first_failed_at")
  failedAt      DateTime  @map("failed_at")
  capturedAt    DateTime  @default(now()) @map("captured_at")

  /// Expurgo por cron. Itens já `reprocessed` saem antes dos `pending`: o que foi
  /// resolvido não precisa ocupar espaço tanto quanto o que ainda espera ação.
  retentionUntil DateTime @map("retention_until")

  /// Preenchidos pelo reprocessamento (Entrega 7).
  reprocessedAt   DateTime? @map("reprocessed_at")
  lastOperationId String?   @map("last_operation_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, capturedAt])
  @@index([capturedAt])
  @@index([correlationId])
  @@index([errorType])
  @@index([phoneHash])
  @@index([retentionUntil])
  @@map("ops_failed_messages")
}

enum RecurrenceType {
  avulso
  fixo
  parcelado
}

enum ReminderStatus {
  pending
  paid
}

model CreditCard {
  id          String   @id @default(uuid())
  accountId   String   @unique @map("account_id")
  brand       String?
  color       String?
  creditLimit Decimal? @map("credit_limit") @db.Decimal(15, 2)
  /// Dia do mês em que a fatura vence (1–28).
  dueDay      Int      @map("due_day")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("credit_cards")
}

model Reminder {
  id                String         @id @default(uuid())
  userId            String         @map("user_id")
  title             String
  amount            Decimal?       @db.Decimal(15, 2)
  dueDate           DateTime       @map("due_date") @db.Date
  isRecurrent       Boolean        @default(false) @map("is_recurrent")
  /// Só relevante quando isRecurrent=true. Sem ela, repete indefinidamente.
  recurrenceEndDate DateTime?      @map("recurrence_end_date") @db.Date
  status            ReminderStatus @default(pending)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reminders")
}

model AgendaEvent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  description String?
  eventDate   DateTime @map("event_date") @db.Date
  /// Formato "HH:mm". Ausente = compromisso do dia todo.
  eventTime   String?  @map("event_time")
  color       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("agenda_events")
}

model Note {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  content   String
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notes")
}

model SpendingGoal {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  categoryId String   @map("category_id")
  amount     Decimal  @db.Decimal(15, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
  @@map("spending_goals")
}
