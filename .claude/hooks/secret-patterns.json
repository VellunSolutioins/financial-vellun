[
  { "name": "chave AWS", "pattern": "AKIA[0-9A-Z]{16}" },
  { "name": "chave Stripe", "pattern": "sk_(live|test)_[0-9a-zA-Z]{16,}" },
  { "name": "chave privada PEM", "pattern": "-----BEGIN (RSA |EC |)PRIVATE KEY-----" },
  { "name": "token Bearer hardcoded", "pattern": "Bearer\\s+[A-Za-z0-9\\-_.]{20,}" },
  { "name": "JWT literal", "pattern": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}" },
  { "name": "segredo/senha em atribuição literal", "pattern": "(secret|password|senha|token|api[_-]?key|private[_-]?key)\\s*[:=]\\s*['\"][^'\"\\s]{8,}['\"]", "flags": "i" },
  { "name": "string de conexão de banco com credencial", "pattern": "postgres(ql)?:\\/\\/[^:\\/\\s]+:[^@\\/\\s]+@" }
]
