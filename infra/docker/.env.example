POSTGRES_USER=vellun
POSTGRES_PASSWORD=vellun_dev_password
POSTGRES_DB=financial_vellun
TZ=America/Sao_Paulo
PGTZ=America/Sao_Paulo

# RabbitMQ (broker do pipeline WhatsApp). Painel: http://localhost:15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Grafana Cloud — só usado por `pnpm obs:up` (Alloy local).
# Vazios, o Alloy sobe, coleta e falha o envio: dá para validar scrape e
# recebimento de log, mas nada fica guardado. Os valores saem de Connections →
# Add new connection → "Hosted Prometheus metrics" e "Hosted logs", no bloco que
# a página gera. Sem aspas: as aspas do bloco são sintaxe do Alloy, não do valor.
GRAFANA_CLOUD_PROM_URL=
# ID numérico da instância do Prometheus.
GRAFANA_CLOUD_PROM_USER=
# URL COMPLETA, com `/loki/api/v1/push` no final — o Alloy usa como está. (Ao
# contrário do `LOKI_PUSH_URL` das aplicações, que é só o endereço base.)
GRAFANA_CLOUD_LOKI_URL=
# ID numérico da instância do Loki — é OUTRO número, não o do Prometheus.
GRAFANA_CLOUD_LOKI_USER=
# Token de escrita (escopo `set:alloy-data-write`), usado nos dois envios.
GRAFANA_CLOUD_TOKEN=
