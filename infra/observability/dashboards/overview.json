{
  "uid": "vellun-overview",
  "title": "Vellun — Visão geral",
  "description": "Estado dos serviços e da infraestrutura em uma tela. O datasource é uma variável, não um UID fixo, para o dashboard ser importável em qualquer organização.",
  "tags": ["vellun", "operacoes"],
  "timezone": "America/Sao_Paulo",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Métricas",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "env",
        "label": "Ambiente",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${ds}" },
        "query": "label_values(up, env)",
        "refresh": 1,
        "current": {},
        "includeAll": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Disponibilidade",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Serviços no ar",
      "description": "Zero significa scrape falhando: processo fora, porta fechada, ou token de métricas errado. Célula vazia (sem dado) é pior que zero — é a coleta fora, e o alerta AusenciaInesperadaDeDados cobre esse caso.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "up{env=\"$env\", job=~\"api|ai-agent|ai-agent-worker|rabbitmq|postgres|redis\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FORA", "color": "red", "index": 0 } } },
            {
              "type": "value",
              "options": { "1": { "text": "no ar", "color": "green", "index": 1 } }
            }
          ],
          "noValue": "sem dado"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disponibilidade no tempo",
      "description": "Buracos na linha são ausência de dado, não zero — a distinção importa.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "up{env=\"$env\", job=~\"api|ai-agent|ai-agent-worker|rabbitmq|postgres|redis\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Pipeline WhatsApp",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Mensagens na DLQ",
      "description": "Qualquer valor diferente de zero pede investigação: chegar à DLQ significa que o retry com backoff já se esgotou. Investigue a causa ANTES de reprocessar.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rabbitmq_detailed_queue_messages_ready{env=\"$env\", queue=~\"whatsapp\\\\..*\\\\.dlq\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "noValue": "sem dado"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Consumidores por fila",
      "description": "Zero com mensagem pendente é o incidente mais grave do pipeline: nada está sendo processado. Filas de retry têm zero por construção — o TTL devolve a mensagem.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 5, "w": 9, "x": 6, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_detailed_queue_consumers{env=\"$env\", queue=~\"whatsapp\\\\.(inbound|processing)\\\\.v1\"}",
          "legendFormat": "{{queue}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "noValue": "sem dado"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Profundidade das filas principais",
      "description": "O que importa é a derivada, não o valor: um pico drenado em segundos é saúde; crescimento sustentado é problema.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_detailed_queue_messages_ready{env=\"$env\", queue=~\"whatsapp\\\\.(inbound|processing)\\\\.v1\"}",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Recursos",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Conexões do Postgres",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_activity_count{env=\"$env\"})",
          "legendFormat": "em uso"
        },
        {
          "refId": "B",
          "expr": "max(pg_settings_max_connections{env=\"$env\"})",
          "legendFormat": "limite"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } }, "overrides": [] }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Memória do Redis",
      "description": "Sem memória, o agrupamento falha e a mensagem volta para a fila — o pipeline degrada em vez de parar, o que é pior de diagnosticar.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes{env=\"$env\"}",
          "legendFormat": "em uso"
        },
        {
          "refId": "B",
          "expr": "redis_memory_max_bytes{env=\"$env\"} > 0",
          "legendFormat": "limite"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Alarmes do RabbitMQ",
      "description": "Quando um alarme dispara, o broker BLOQUEIA publicações: o webhook passa a devolver 503 e o cliente perde o lançamento.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_alarms_memory_used_watermark{env=\"$env\"}",
          "legendFormat": "memória"
        },
        {
          "refId": "B",
          "expr": "rabbitmq_alarms_free_disk_space_watermark{env=\"$env\"}",
          "legendFormat": "disco"
        },
        {
          "refId": "C",
          "expr": "rabbitmq_alarms_file_descriptor_limit{env=\"$env\"}",
          "legendFormat": "descritores"
        }
      ],
      "fieldConfig": {
        "defaults": { "min": 0, "max": 1, "custom": { "fillOpacity": 20, "lineWidth": 2 } },
        "overrides": []
      }
    }
  ]
}
