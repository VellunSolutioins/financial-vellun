FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY apps/ai-agent/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY apps/ai-agent/src ./src

# Por padrao serve o webhook. Com RUN_CONSUMERS_IN_API=true (padrao) esta mesma
# imagem tambem consome as filas; para separar os processos, suba uma segunda
# instancia com RUN_CONSUMERS_IN_API=false na API e
# `command: python -m src.worker` no container de worker.
CMD ["sh", "-c", "uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8010}"]
